# The virtual environment: 102 MB, and the pins live in AGENTS.md instead.
.venv/
__pycache__/
*.py[cod]

# The speech model: 87 MB, and Vosk publishes it under its own licence.
models/

# Build output. dist\WinVosk\ is 172 MB and bundles someone else's libvosk,
# libstdc++ and the Tcl script library; build\ is PyInstaller's work folder and
# the generated WinVosk.ico. Both come out of tools\build_exe.py.
dist/
build/

# Machine state, not part of a checkout.
logs/
tmp/
raw/
backup/
*.zip
*.lnk
settings.json
settings.json.tmp

# The user's own word list. phrases.example.txt is the shipped template and the
# list itself is personal: tools\package_release.py refuses to ship it.
phrases.txt

# Local working notes: this machine's delivery process, not the product.
# Everything under docs\instructions\ is an agent prompt rather than product
# documentation: the install procedure the tracked setup.md used to hold now
# lives in README.md, so nothing there is a document of the product.
STAGES.md
stage_report.md
MEMORY.MD
docs/instructions/
docs/stages/
docs/reports/

# Marketing research. A competitor teardown and a keyword list are not
# documentation of the code, and they do not belong in a public repository.
docs/competitors.md
docs/seo_keywords.md

# The full-size banner, kept locally so a smaller one can be regenerated from
# it. Only the reduced WinVosk_banner.png is tracked; shipping both would put
# 2.4 MB into the repository for a file nothing renders.
docs/img/WinVosk_banner_max.png

# Windows noise.
Thumbs.db
desktop.ini
.plan/


# Local renders that no page points at: a dark banner, a line banner, two
# reduced variants, a scratch chip frame and a superseded banner. The images
# the guides actually embed are whatever git ls-files docs/img lists. The dark
# banner alone is 6.4 MB, three times the tracked one, so these are kept out
# rather than committed and deleted afterwards, which would leave them in history
# for good.
docs/img/winvosk-banner-dark.png
docs/img/WinVosk_banner_old.png
docs/img/WinVosk-line.png
docs/img/WinVosk-small.png
docs/img/WinWosk-Private.png
docs/img/chip2.png